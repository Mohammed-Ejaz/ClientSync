# MongoDB Connection URL (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clientsync?retryWrites=true&w=majority

# JWT Secret for Session Authentication (minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Server Port
PORT=5000

# Frontend URL & Allowed CORS Origins (comma-separated for multiple domains)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-app.vercel.app
